{
  "name": "dsh-whale-bridge",
  "version": "0.1.0",
  "description": "Read-only DSH Host status bridge for the Big-Fat-Fish desktop pet: fixed atomic status JSON file plus GET /api/whale/status, category/tool-name/count/timestamp only.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "status-bridge"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./status": "./lib/status.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/status.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
